@model List<Student>
@{ ViewData["Title"]="Students"; }
<div class="page-heading"><div><div class="eyebrow">RESIDENT DIRECTORY</div><h1>Students</h1><p>Manage hostel residents and their room allocations.</p></div><a class="btn btn-primary" asp-action="Create">＋ Add Student</a></div>
@if(TempData["Message"]!=null){<div class="alert">✓ @TempData["Message"]</div>}
<div class="panel"><form method="get" class="search-row"><div class="search-box"><span>⌕</span><input name="search" value="@ViewBag.Search" placeholder="Search name, enrollment or room..." /></div><button class="btn btn-outline" type="submit">Search</button>@if(!string.IsNullOrEmpty((string?)ViewBag.Search)){<a class="text-link" asp-action="Index">Clear</a>}</form>
@if(Model.Count>0){<div class="table-wrap"><table><thead><tr><th>STUDENT</th><th>ENROLLMENT NO.</th><th>CONTACT</th><th>ROOM</th><th>SEMESTER</th><th>ACTIONS</th></tr></thead><tbody>@foreach(var s in Model){<tr><td><div class="person"><span class="person-avatar">@s.FullName.Substring(0,1).ToUpper()</span><strong>@s.FullName</strong></div></td><td>@s.EnrollmentNo</td><td><span>@s.Phone</span><small class="subline">@s.Email</small></td><td><span class="room-pill">Room @s.RoomNumber</span></td><td>@s.Semester</td><td><div class="actions"><a class="action-link" asp-action="Edit" asp-route-id="@s.Id">Edit</a><form asp-action="Delete" asp-route-id="@s.Id" method="post"><button class="action-link danger" type="submit" data-confirm="Delete this student record?">Delete</button></form></div></td></tr>}</tbody></table></div>}else{<div class="empty"><div class="empty-icon">⌕</div><h3>No matching students</h3><p>Try another search or add a new student.</p></div>}</div>
