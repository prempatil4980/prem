@model Student
@{ ViewData["Title"]="Edit Student"; }
<div class="page-heading"><div><div class="eyebrow">RESIDENT DIRECTORY</div><h1>Edit Student</h1><p>Update resident information and room allocation.</p></div><a class="btn btn-outline" asp-action="Index">← Back to Students</a></div>
<div class="panel form-panel"><form asp-action="Edit" method="post"><input type="hidden" asp-for="Id"/><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div class="field"><label asp-for="FullName">Full Name</label><input asp-for="FullName"/><span asp-validation-for="FullName"></span></div><div class="field"><label asp-for="EnrollmentNo">Enrollment Number</label><input asp-for="EnrollmentNo"/><span asp-validation-for="EnrollmentNo"></span></div><div class="field"><label asp-for="Email">Email Address</label><input asp-for="Email"/><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Phone">Phone Number</label><input asp-for="Phone"/><span asp-validation-for="Phone"></span></div><div class="field"><label asp-for="RoomNumber">Assign Room</label><select asp-for="RoomNumber">@foreach(Room r in ViewBag.Rooms){<option value="@r.Number">Room @r.Number — @r.Type (@r.Capacity beds)</option>}</select><span asp-validation-for="RoomNumber"></span></div><div class="field"><label asp-for="Semester">Semester</label><select asp-for="Semester">@for(int i=1;i<=8;i++){<option value="@i">Semester @i</option>}</select><span asp-validation-for="Semester"></span></div><div class="field"><label asp-for="AdmissionDate">Admission Date</label><input asp-for="AdmissionDate" type="date"/><span asp-validation-for="AdmissionDate"></span></div></div><div class="form-actions"><a class="btn btn-outline" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Update Student</button></div></form></div>
