<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] - StaySpace</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><aside class="sidebar"><div class="brand"><span class="brand-icon">⌂</span><span>StaySpace<small>HOSTEL MANAGER</small></span></div><div class="nav-label">WORKSPACE</div><a class="nav-link" asp-controller="Home" asp-action="Index">▦ &nbsp; Dashboard</a><a class="nav-link" asp-controller="Students" asp-action="Index">♙ &nbsp; Students</a><a class="nav-link" asp-controller="Rooms" asp-action="Index">▤ &nbsp; Rooms</a><div class="sidebar-bottom"><div class="avatar">HM</div><div><strong>Hostel Admin</strong><small>Administrator</small></div></div></aside><main class="main"><header class="topbar"><div><span class="eyebrow">HOSTEL MANAGEMENT</span><strong>@ViewData["Title"]</strong></div><span class="today">● &nbsp; Local demo · No database</span></header><div class="content">@RenderBody()</div><footer>StaySpace Hostel Management <span>Mini project · ASP.NET Core MVC</span></footer></main><script>document.querySelectorAll('[data-confirm]').forEach(x=>x.addEventListener('click',e=>{if(!confirm(x.dataset.confirm))e.preventDefault()}));</script>@await RenderSectionAsync("Scripts", required: false)</body></html>
