@{ ViewData["Title"]="Dashboard"; }
<div class="welcome"><div><div class="eyebrow light">YOUR HOSTEL AT A GLANCE</div><h1>Welcome back, Admin 👋</h1><p>Here’s what’s happening at your hostel today.</p></div><a class="btn btn-white" asp-controller="Students" asp-action="Create">＋ Add Student</a></div>
<div class="stats"><div class="stat-card"><div class="stat-icon purple">♙</div><span>Total Students</span><strong>@ViewBag.StudentCount</strong><small>Registered residents</small></div><div class="stat-card"><div class="stat-icon blue">▤</div><span>Total Rooms</span><strong>@ViewBag.RoomCount</strong><small>Available room units</small></div><div class="stat-card"><div class="stat-icon green">⌂</div><span>Occupied Rooms</span><strong>@ViewBag.OccupiedRooms</strong><small>Rooms with residents</small></div><div class="stat-card"><div class="stat-icon orange">✳</div><span>Available Beds</span><strong>@ViewBag.AvailableBeds</strong><small>Capacity remaining</small></div></div>
<div class="panel"><div class="panel-head"><div><h2>Recently Added Students</h2><p>Latest resident records appear here automatically.</p></div><a class="text-link" asp-controller="Students" asp-action="Index">View all students →</a></div>
@if (((IEnumerable<Student>)ViewBag.RecentStudents).Any()) { <div class="table-wrap"><table><thead><tr><th>STUDENT</th><th>ENROLLMENT NO.</th><th>ROOM</th><th>SEMESTER</th></tr></thead><tbody>@foreach(var s in (IEnumerable<Student>)ViewBag.RecentStudents){<tr><td><div class="person"><span class="person-avatar">@s.FullName.Substring(0,1).ToUpper()</span><strong>@s.FullName</strong></div></td><td>@s.EnrollmentNo</td><td><span class="room-pill">Room @s.RoomNumber</span></td><td>Semester @s.Semester</td></tr>}</tbody></table></div> } else { <div class="empty"><div class="empty-icon">♙</div><h3>No students added yet</h3><p>Add your first student and the dashboard will update automatically.</p><a class="btn btn-primary" asp-controller="Students" asp-action="Create">＋ Add First Student</a></div> }</div>
<div class="note"><strong>Demo note:</strong> This project uses in-memory data only. Records update the dashboard while the app is running and reset when the application restarts.</div>
