@model List<Room>
@{ ViewData["Title"]="Rooms"; var occupied=(Dictionary<string,int>)ViewBag.Occupied; }
<div class="page-heading"><div><div class="eyebrow">ACCOMMODATION</div><h1>Room Management</h1><p>Check room capacity, occupancy and monthly fees.</p></div><a class="btn btn-primary" asp-controller="Students" asp-action="Create">＋ Assign Student</a></div>
<div class="room-grid">@foreach(var r in Model){var count=occupied.ContainsKey(r.Number)?occupied[r.Number]:0;var full=count>=r.Capacity;<div class="room-card"><div class="room-card-top"><div class="room-symbol">▤</div><span class="status @(full?"status-full":count>0?"status-occupied":"status-available")">@(full?"Full":count>0?"Occupied":"Available")</span></div><div class="room-number">Room @r.Number</div><div class="room-type">@r.Type</div><div class="occupancy"><div><span>Occupancy</span><strong>@count / @r.Capacity beds</strong></div><div class="progress"><span style="width:@(Math.Min(100,count*100/Math.Max(1,r.Capacity)))%"></span></div></div><div class="room-card-bottom"><span>Monthly fee</span><strong>₹@r.MonthlyFee.ToString("N0") <small>/ bed</small></strong></div></div>}</div>
<div class="note"><strong>Room assignment:</strong> Add or edit a student to assign them to a room. Room occupancy and dashboard counts update automatically.</div>
